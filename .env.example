# Local PostgreSQL settings. Copy this file to .env and replace the password.
POSTGRES_USER=sprout
POSTGRES_PASSWORD=replace-with-a-long-random-local-password
POSTGRES_DB=sprout
POSTGRES_PORT=5432

# Keep the credentials synchronized with the values above.
DATABASE_URL=postgresql://sprout:replace-with-a-long-random-local-password@127.0.0.1:5432/sprout
