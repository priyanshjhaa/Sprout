# Local PostgreSQL settings. Copy this file to .env and replace the password.
POSTGRES_USER=sprout
POSTGRES_PASSWORD=replace-with-a-long-random-local-password
POSTGRES_DB=sprout
POSTGRES_PORT=5432

# Keep the credentials synchronized with the values above.
DATABASE_URL=postgresql://sprout:replace-with-a-long-random-local-password@127.0.0.1:5432/sprout

# Go API
SPROUT_API_ADDRESS=127.0.0.1:8080
SPROUT_WEB_ORIGIN=http://localhost:3000

# Clerk development application keys (keep the secret only in ignored local env files).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=replace-with-clerk-publishable-key
CLERK_SECRET_KEY=replace-with-clerk-secret-key
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/start
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/start

# Public local API address used by the browser dashboard.
NEXT_PUBLIC_SPROUT_API_URL=http://127.0.0.1:8080
